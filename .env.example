# ── 화면이 부를 API 주소 ─────────────────────────────────────────
# 같은 프로젝트 안의 /api/v1을 씁니다. 나중에 백엔드를 따로 떼어내면
# 이 줄만 바꾸면 화면 코드는 그대로입니다.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ── Supabase (서버 전용) ────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 가져옵니다.
#
# ⚠ SERVICE_ROLE 키는 모든 접근 제한을 통과합니다. 절대 밖으로 내보내지 마세요.
#   이름에 NEXT_PUBLIC_이 없는 이유입니다 — 붙이면 브라우저로 새어 나갑니다.
#   .env.local은 git에 올라가지 않습니다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── 담당자 로그인 (목업) ────────────────────────────────────────
# 실제 서비스에서는 계정별 비밀번호 해시로 바꿔야 합니다.
STAFF_DEV_PASSWORD=advisory
